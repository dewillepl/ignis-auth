# Ignis authentication.
#
# Generate the hash with:
#   npm run auth:hash
# or, without a local Node install:
#   docker run --rm ignis:local node apps/ignis-server/scripts/hash-password.js 'yourpassword'
#
# The generator prints the hash with every "$" doubled. That is required: docker-compose
# treats a single "$" in .env as variable interpolation and silently mangles the hash
# (quoting the value does NOT prevent it). The server accepts both forms.

AUTH_USERNAME=kuba
# bcrypt("changeme") - replace before exposing the app anywhere.
AUTH_PASSWORD_HASH=$$2b$$12$$Dm9cYo8RwZtT.EvjfWFkLO25rEyxGLXFF5zg1y.JjK.K9kmrYPz5a

# Optional. A random one is generated and stored in /app/data/.session-secret on first start.
# Set it explicitly to keep sessions valid across a data-volume reset, or to sign everyone out
# by changing it.
#AUTH_SESSION_SECRET=

# How long a session lasts. Default 168 (7 days).
#AUTH_SESSION_TTL_HOURS=168

# Failed logins per IP before a lockout, and how long the lockout lasts.
#AUTH_MAX_ATTEMPTS=5
#AUTH_LOCKOUT_MINUTES=15

# Set to true when Ignis is served over HTTPS, so the session cookie is marked Secure.
#AUTH_COOKIE_SECURE=false

# Set to true only behind a reverse proxy you trust to set X-Forwarded-For; the login
# rate limit keys on it.
#AUTH_TRUST_PROXY=false

# Explicitly turn the login gate off. Without credentials it is off anyway; with
# AUTH_ENABLED=true and no credentials the server refuses to start.
#AUTH_ENABLED=true
